# PostgreSQL used by the analytical model and Dagster metadata.
POSTGRES_DB=lakehouse
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lakehouse:change-me@localhost:5432/lakehouse

# Local Parquet staging layer.
STAGING_PATH=../data/staging

# Salesforce credentials. Prefer a dedicated integration user.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login


