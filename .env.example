# PostgreSQL used by the analytical model and Dagster metadata.
POSTGRES_DB=lakehouse
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lakehouse:change-me@localhost:5432/lakehouse

# Production Dagster/PostgreSQL connection (configured as Coolify secrets).
DAGSTER_PG_HOST=postgres-host
DAGSTER_PG_PORT=5432
DAGSTER_PG_DB=db_dlh_aisosbo
DAGSTER_PG_USER=postgres
DAGSTER_PG_PASSWORD=change-me

# Local Parquet staging layer.
STAGING_PATH=../data/staging
INGESTION_ROOT=../exportaciones
MAX_UPLOAD_BYTES=536870912
DAGSTER_GRAPHQL_URL=http://dagster-webserver:3000/graphql

# Salesforce credentials. Prefer a dedicated integration user.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
SALESFORCE_DOMAIN=login
